meta {
  name: List Roles
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/orgs/:org_id/roles
  body: none
  auth: bearer
}

params:path {
  org_id: 00000000-0000-0000-0000-000000000000
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Requires org:manage_roles on the caller's role in this org.

  200 OK:
  [
    { "id": "<uuid>", "name": "owner", "permissions": ["org:manage_members", "org:manage_roles", "db:query", "db:sync"] }
  ]
}
