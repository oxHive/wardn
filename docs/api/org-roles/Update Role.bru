meta {
  name: Update Role
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/orgs/:org_id/roles/:role_id
  body: json
  auth: bearer
}

params:path {
  org_id: 00000000-0000-0000-0000-000000000000
  role_id: 00000000-0000-0000-0000-000000000000
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "permissions": ["db:query", "db:sync"]
  }
}

docs {
  Requires org:manage_roles on the caller's role in this org.
  Replaces the role's full permission set with the one given.

  200 OK:
  {
    "id": "<uuid>",
    "name": "<string>",
    "permissions": ["db:query", "db:sync"]
  }
}
