meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com"
  }
}

docs {
  Public, unauthenticated — this is how a caller gets their first API key.
  Rate-limited per source IP (5 request burst, then a slow trickle).

  201 Created:
  {
    "user_id": "<uuid>",
    "api_key": "<full key, shown exactly once>"
  }

  409 Conflict if the email is already registered.

  Save the returned api_key into the `apiKey` environment variable to
  authenticate the rest of this collection's requests.
}
