meta {
  name: Remove Member
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/orgs/:org_id/members/:user_id
  body: none
  auth: bearer
}

params:path {
  org_id: 00000000-0000-0000-0000-000000000000
  user_id: 00000000-0000-0000-0000-000000000000
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Requires org:manage_members on the caller's role in this org.

  204 No Content on success.
}
