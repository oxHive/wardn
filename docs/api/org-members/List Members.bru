meta {
  name: List Members
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/orgs/:org_id/members
  body: none
  auth: bearer
}

params:path {
  org_id: 00000000-0000-0000-0000-000000000000
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Requires org:manage_members on the caller's role in this org.

  200 OK:
  [
    { "user_id": "<uuid>", "email": "<string>", "role_id": "<uuid>" }
  ]
}
