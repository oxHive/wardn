meta {
  name: Assign Member Role
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/orgs/:org_id/members/:user_id/role
  body: json
  auth: bearer
}

params:path {
  org_id: 00000000-0000-0000-0000-000000000000
  user_id: 00000000-0000-0000-0000-000000000000
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "role_id": "00000000-0000-0000-0000-000000000000"
  }
}

docs {
  Requires org:manage_members on the caller's role in this org.
  `role_id` must be a role belonging to the same org.

  200 OK:
  {
    "user_id": "<uuid>",
    "role_id": "<uuid>"
  }
}
