meta {
  name: Create API Key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api-keys
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Mints an additional personal key for the caller. 403 if the caller's key
  is org/workspace-owned rather than personal.

  201 Created:
  {
    "id": "<uuid>",
    "api_key": "<full key, shown exactly once>"
  }
}
