meta {
  name: Revoke API Key
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api-keys/:id
  body: none
  auth: bearer
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Revokes one of the caller's own keys. Idempotent — revoking an
  already-revoked key still returns 204.

  404 (never 403) for a key id that exists but isn't the caller's own, so
  the response can't be used to confirm another user's key id exists.

  204 No Content on success.
}
