# Copy to .env (or export these directly) before running `cargo run`/`cargo test`
# outside of podman-compose. Inside podman-compose, the gateway service sets
# these itself (see podman-compose.yml) — you don't need this file for that.

DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5433/gateway
SQLD_URL=http://127.0.0.1:8081
# Used by database provisioning (creating a namespace on POST /users and
# POST /orgs) as well as tests that exercise sqld's admin API directly.
SQLD_ADMIN_URL=http://127.0.0.1:8090
LISTEN_ADDR=127.0.0.1:8787
# Required bearer token for GET /metrics (src/observability.rs) — the
# per-tenant `namespace` label on proxy metrics would otherwise let anyone
# enumerate every tenant's UUID and traffic volume through this endpoint.
METRICS_TOKEN=dev-metrics-token
# Server-side secret folded into every API key's HMAC-SHA256 hash
# (src/auth.rs) — must be at least 32 characters. A leaked key_hash column
# alone doesn't let an attacker forge valid keys without also knowing this.
API_KEY_PEPPER=dev-api-key-pepper-do-not-use-in-prod-min-32-chars
