# Copy to .env (or export these directly) before running `cargo run`/`cargo test`.
# None of these are required — every one has a sensible default — but they're
# here for reference and for anyone running multiple wardn instances
# side by side (see WARDN_SPECIFICATION.md's Decision 2).

# Path to the local libSQL database file this instance manages. Defaults to
# ~/.local/share/wardn/org.db.
WARDN_DB_PATH=./org.db

# Bind address for `wardn serve`, the HTTP authorization service Mynd calls.
# Defaults to 127.0.0.1:7787 — loopback only, since this is a single-org
# authorization service, not a public API.
WARDN_LISTEN_ADDR=127.0.0.1:7787

# Optional. Log verbosity (tracing-subscriber's EnvFilter syntax). Defaults
# to "info".
RUST_LOG=info

# --- Observability (all optional, all off by default) ---
# Requires the "observability" Cargo feature, which is on by default — see
# WARDN_SPECIFICATION.md's Decision 3 for why a minimal build might drop it
# entirely with `cargo build --no-default-features`. Each of the three vars
# below toggles one independent piece; setting none of them means `wardn
# serve` behaves exactly as if the feature weren't compiled in at all.
# `podman-compose --profile observability up` brings up a local Loki/Tempo/
# otel-collector/Prometheus/Grafana stack these can point at.

# Required to turn on GET /metrics at all — unset means the route always
# 404s, not just "unauthenticated". When set, it's also the bearer token
# callers (e.g. Prometheus) must present.
WARDN_METRICS_TOKEN=dev-metrics-token

# OTLP/gRPC endpoint traces are exported to. Unset means spans are still
# created (and logged) but never exported anywhere.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Base URL of a Loki instance to push logs to. Unset means logs stay
# stdout-only (as JSON, once `wardn serve` is running).
LOKI_URL=http://127.0.0.1:3100
