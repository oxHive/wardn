# Copy to .env (or export these directly) before running `cargo run`/`cargo test`
# outside of podman-compose. Inside podman-compose, the gateway service sets
# these itself (see podman-compose.yml) — you don't need this file for that.

DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5433/gateway
SQLD_URL=http://127.0.0.1:8081
# Only used by tests that exercise sqld's admin API (namespace creation).
SQLD_ADMIN_URL=http://127.0.0.1:8090
LISTEN_ADDR=127.0.0.1:8787
